@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uçuş Sonuçları — SkyRoute</title>

    <!-- Bootstrap Icons (yalnızca ikon için) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* =========================================================
                   SkyRoute — Search sayfası (bağımsız, sf- prefix'li)
                ========================================================= */
        :root {
            --sf-primary: #1466d6;
            --sf-primary-dark: #0f4fa8;
            --sf-accent: #ff7a00;
            --sf-ink: #10233b;
            --sf-muted: #5b6b7d;
            --sf-line: #e4e9f0;
            --sf-bg: #f4f7fb;
            --sf-card: #ffffff;
            --sf-radius: 16px;
            --sf-shadow: 0 6px 24px rgba(16, 35, 59, .08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--sf-bg);
            color: var(--sf-ink);
            -webkit-font-smoothing: antialiased;
        }

        .sf-container {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 16px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ---------- Üst bar ---------- */
        .sf-topbar {
            background: var(--sf-card);
            border-bottom: 1px solid var(--sf-line);
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .sf-topbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
        }

        .sf-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 800;
            font-size: 1.25rem;
            color: var(--sf-ink);
        }

        .sf-logo-mark {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            background: var(--sf-primary);
            color: #fff;
            border-radius: 10px;
            font-size: 1rem;
        }

        .sf-logo-accent {
            color: var(--sf-primary);
        }

        .sf-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
            font-size: .9rem;
            color: var(--sf-primary);
            padding: 8px 14px;
            border-radius: 10px;
            transition: background .15s;
        }

            .sf-back:hover {
                background: #eaf1fc;
            }

        /* ---------- Özet çubuğu ---------- */
        .sf-summary {
            background: linear-gradient(135deg, var(--sf-primary), var(--sf-primary-dark));
            color: #fff;
            padding: 22px 0;
        }

        .sf-summary-route {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.4rem;
            font-weight: 800;
            flex-wrap: wrap;
        }

            .sf-summary-route .sf-iata {
                font-size: .95rem;
                font-weight: 700;
                background: rgba(255,255,255,.18);
                padding: 2px 8px;
                border-radius: 6px;
                margin-left: 4px;
            }

            .sf-summary-route i {
                font-size: 1.05rem;
                opacity: .85;
            }

        .sf-summary-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 18px;
            margin-top: 10px;
            font-size: .9rem;
            color: rgba(255,255,255,.9);
        }

            .sf-summary-meta span {
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .sf-summary-meta i {
                opacity: .8;
            }

        /* ---------- Sonuç alanı ---------- */
        .sf-results {
            padding: 26px 0 60px;
        }

        .sf-results-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .sf-results-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0;
        }

        .sf-results-count {
            font-size: .88rem;
            color: var(--sf-muted);
        }

        /* ---------- Uçuş kartı ---------- */
        .sf-card {
            background: var(--sf-card);
            border: 1px solid var(--sf-line);
            border-radius: var(--sf-radius);
            box-shadow: var(--sf-shadow);
            padding: 18px 20px;
            margin-bottom: 14px;
            display: grid;
            grid-template-columns: 1.2fr 2.4fr 1fr;
            gap: 18px;
            align-items: center;
            transition: transform .15s, box-shadow .15s;
        }

            .sf-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(16,35,59,.12);
            }

        /* havayolu */
        .sf-airline {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sf-airline-logo {
            width: 40px;
            height: 40px;
            object-fit: contain;
            border-radius: 8px;
            background: #f4f7fb;
            padding: 4px;
        }

        .sf-airline-logo-fallback {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: #eaf1fc;
            color: var(--sf-primary);
            display: grid;
            place-items: center;
            font-size: 1.1rem;
        }

        .sf-airline-name {
            font-weight: 600;
            font-size: .92rem;
            line-height: 1.2;
        }

        /* saat + rota */
        .sf-times {
            display: flex;
            align-items: center;
            gap: 14px;
            justify-content: center;
        }

        .sf-time-block {
            text-align: center;
            min-width: 64px;
        }

        .sf-time {
            font-size: 1.15rem;
            font-weight: 800;
        }

        .sf-time-airport {
            font-size: .78rem;
            color: var(--sf-muted);
            font-weight: 600;
            margin-top: 2px;
        }

        .sf-path {
            flex: 1;
            text-align: center;
            min-width: 90px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
        }

        .sf-duration {
            font-size: .78rem;
            color: var(--sf-muted);
            font-weight: 600;
        }

        .sf-path-line {
            width: 100%;
            height: 2px;
            background: var(--sf-line);
            position: relative;
        }

            .sf-path-line::after {
                content: '\F1E6'; /* airplane */
                font-family: 'bootstrap-icons';
                position: absolute;
                right: -4px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--sf-primary);
                font-size: .8rem;
                background: var(--sf-card);
                padding-left: 2px;
            }

        .sf-stops {
            font-size: .74rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
        }

        .sf-stops-direct {
            background: #e6f6ec;
            color: #157347;
        }

        .sf-stops-1 {
            background: #fff3e0;
            color: #b26a00;
        }

        .sf-stops-more {
            background: #fdeaea;
            color: #c0392b;
        }

        .sf-layover {
            font-size: .72rem;
            color: var(--sf-muted);
            margin-top: 1px;
        }

        /* fiyat */
        .sf-price-block {
            text-align: right;
        }

        .sf-price {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--sf-ink);
            white-space: nowrap;
        }

        .sf-price-cur {
            font-size: .85rem;
            font-weight: 700;
            color: var(--sf-muted);
        }

        .sf-price-unavailable {
            font-size: .9rem;
            font-weight: 600;
            color: var(--sf-muted);
        }

        .sf-select-btn {
            margin-top: 8px;
            display: inline-block;
            background: var(--sf-primary);
            color: #fff;
            font-weight: 600;
            font-size: .85rem;
            padding: 8px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: background .15s;
        }

            .sf-select-btn:hover {
                background: var(--sf-primary-dark);
            }

        /* ---------- Durumlar (loading / hata / boş) ---------- */
        .sf-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--sf-muted);
        }

            .sf-state i {
                font-size: 2.4rem;
                display: block;
                margin-bottom: 12px;
            }

        .sf-spinner {
            width: 42px;
            height: 42px;
            margin: 0 auto 16px;
            border: 4px solid var(--sf-line);
            border-top-color: var(--sf-primary);
            border-radius: 50%;
            animation: sf-spin .8s linear infinite;
        }

        @@keyframes sf-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .sf-skeleton {
            background: var(--sf-card);
            border: 1px solid var(--sf-line);
            border-radius: var(--sf-radius);
            height: 92px;
            margin-bottom: 14px;
            overflow: hidden;
            position: relative;
        }

            .sf-skeleton::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, transparent, rgba(0,0,0,.04), transparent);
                animation: sf-shimmer 1.3s infinite;
            }

        @@keyframes sf-shimmer {
            0% {
                transform: translateX(-100%);
            }

            100% {
                transform: translateX(100%);
            }
        }

        .sf-retry-btn {
            margin-top: 14px;
            background: var(--sf-primary);
            color: #fff;
            border: none;
            padding: 10px 22px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 768px) {
            .sf-card {
                grid-template-columns: 1fr;
                gap: 14px;
                text-align: center;
            }

            .sf-airline {
                justify-content: center;
            }

            .sf-price-block {
                text-align: center;
            }

            .sf-summary-route {
                font-size: 1.2rem;
                justify-content: center;
            }

            .sf-summary-meta {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- ---------- Üst bar ---------- -->
    <header class="sf-topbar">
        <div class="sf-container sf-topbar-inner">
            <a href="/Flight/Index" class="sf-logo">
                <span class="sf-logo-mark"><i class="bi bi-send-fill"></i></span>
                Sky<span class="sf-logo-accent">Route</span>
            </a>
            <a href="/Flight/Index" class="sf-back">
                <i class="bi bi-arrow-left"></i> Aramayı Değiştir
            </a>
        </div>
    </header>

    <!-- ---------- Özet çubuğu ---------- -->
    <section class="sf-summary">
        <div class="sf-container">
            <div class="sf-summary-route" id="sfRoute">
                <!-- JS dolduracak -->
            </div>
            <div class="sf-summary-meta" id="sfMeta">
                <!-- JS dolduracak -->
            </div>
        </div>
    </section>

    <!-- ---------- Sonuçlar ---------- -->
    <main class="sf-results">
        <div class="sf-container">
            <div class="sf-results-head">
                <h1 class="sf-results-title" id="sfResultTitle">Uçuşlar</h1>
                <span class="sf-results-count" id="sfResultCount"></span>
            </div>

            <div id="sfList">
                <!-- JS: skeleton / kartlar / durum mesajları -->
            </div>
        </div>
    </main>

    <script>
        (function () {
            'use strict';

            /* ---------- 0. Query parametrelerini oku ---------- */
            const p = new URLSearchParams(window.location.search);
            const g = (k, d = '') => p.get(k) || d;

            const fromCity = g('fromCity');
            const toCity   = g('toCity');
            const fromIata = g('fromIata');   // Index'ten gelen tahmini IATA (özet için)
            const toIata   = g('toIata');
            const depart   = g('depart');
            const ret      = g('return');
            const adults   = parseInt(g('adults', '1'), 10);
            const children = parseInt(g('children', '0'), 10);
            const infants  = parseInt(g('infants', '0'), 10);
            const cabin    = g('cabin', 'economy');
            const currency = g('currency', 'TRY');
            const tripType = g('tripType', 'round');

            /* ---------- Etiketler ---------- */
            const cabinLabels = {
                economy: 'Ekonomi', premium: 'Premium Ekonomi',
                business: 'Business', first: 'First Class'
            };
            const tripLabels = { round: 'Gidiş-Dönüş', oneway: 'Tek Yön', multi: 'Çoklu Uçuş' };
            const aylar = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];

            function fmtDate(iso) {
                if (!iso) return '';
                const d = new Date(iso + 'T00:00:00');
                if (isNaN(d)) return iso;
                return `${d.getDate()} ${aylar[d.getMonth()]} ${d.getFullYear()}`;
            }

            function paxText() {
                const parts = [];
                if (adults)   parts.push(`${adults} Yetişkin`);
                if (children) parts.push(`${children} Çocuk`);
                if (infants)  parts.push(`${infants} Bebek`);
                return parts.join(', ') || '1 Yetişkin';
            }

            const esc = s => String(s ?? '')
                .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

            /* ---------- 1. Özet çubuğunu doldur ---------- */
            const routeEl = document.getElementById('sfRoute');
            routeEl.innerHTML =
                `<span>${esc(fromCity)}${fromIata ? `<span class="sf-iata">${esc(fromIata)}</span>` : ''}</span>` +
                `<i class="bi bi-airplane"></i>` +
                `<span>${esc(toCity)}${toIata ? `<span class="sf-iata">${esc(toIata)}</span>` : ''}</span>`;

            let dateStr = fmtDate(depart);
            if (tripType === 'round' && ret) dateStr += ` – ${fmtDate(ret)}`;

            document.getElementById('sfMeta').innerHTML =
                `<span><i class="bi bi-calendar-event"></i> ${dateStr}</span>` +
                `<span><i class="bi bi-people"></i> ${paxText()}</span>` +
                `<span><i class="bi bi-briefcase"></i> ${cabinLabels[cabin] || 'Ekonomi'}</span>` +
                `<span><i class="bi bi-arrow-left-right"></i> ${tripLabels[tripType] || 'Gidiş-Dönüş'}</span>`;

            document.getElementById('sfResultTitle').textContent =
                `${fromCity || 'Kalkış'} – ${toCity || 'Varış'} Uçuşları`;

            /* ---------- 2. Yardımcı: kart HTML'i ---------- */
            function airlineLogo(flight) {
                if (flight.airlineLogo) {
                    return `<img src="${esc(flight.airlineLogo)}" alt="${esc(flight.airline)}"
                                 class="sf-airline-logo"
                                 onerror="this.outerHTML='<span class=\\'sf-airline-logo-fallback\\'><i class=\\'bi bi-airplane\\'></i></span>'">`;
                }
                return `<span class="sf-airline-logo-fallback"><i class="bi bi-airplane"></i></span>`;
            }

            function stopsBadge(flight) {
                if (flight.stops === 0) {
                    return `<span class="sf-stops sf-stops-direct">Direkt</span>`;
                }
                const cls = flight.stops === 1 ? 'sf-stops-1' : 'sf-stops-more';
                const layo = (flight.layoverCities && flight.layoverCities.length)
                    ? `<span class="sf-layover">${esc(flight.layoverCities.join(', '))}</span>`
                    : '';
                return `<span class="sf-stops ${cls}">${flight.stops} Aktarma</span>${layo}`;
            }

            function priceBlock(flight) {
                const raw = (flight.price || '').toString().toLowerCase();
                if (!flight.price || raw === 'unavailable') {
                    return `<div class="sf-price-unavailable">Fiyat bulunamadı</div>`;
                }
                // sayıyı binlik ayraçla göster
                const num = Number(flight.price);
                const shown = isNaN(num) ? esc(flight.price) : num.toLocaleString('tr-TR');
                return `
                    <div class="sf-price">${shown} <span class="sf-price-cur">${esc(currency)}</span></div>
                    <button class="sf-select-btn">Seç</button>`;
            }

            function cardHtml(f) {
                return `
                    <article class="sf-card">
                        <div class="sf-airline">
                            ${airlineLogo(f)}
                            <div class="sf-airline-name">${esc(f.airline) || 'Havayolu'}</div>
                        </div>
                        <div class="sf-times">
                            <div class="sf-time-block">
                                <div class="sf-time">${esc(f.departureTime) || '--'}</div>
                                <div class="sf-time-airport">${esc(f.departureAirport)}</div>
                            </div>
                            <div class="sf-path">
                                <div class="sf-duration">${esc(f.durationText)}</div>
                                <div class="sf-path-line"></div>
                                ${stopsBadge(f)}
                            </div>
                            <div class="sf-time-block">
                                <div class="sf-time">${esc(f.arrivalTime) || '--'}</div>
                                <div class="sf-time-airport">${esc(f.arrivalAirport)}</div>
                            </div>
                        </div>
                        <div class="sf-price-block">
                            ${priceBlock(f)}
                        </div>
                    </article>`;
            }

            /* ---------- 3. Durum gösterimleri ---------- */
            const listEl = document.getElementById('sfList');
            const countEl = document.getElementById('sfResultCount');

            function showSkeleton() {
                listEl.innerHTML = Array(4).fill('<div class="sf-skeleton"></div>').join('');
            }
            function showError(msg) {
                listEl.innerHTML = `
                    <div class="sf-state">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div>${esc(msg || 'Uçuşlar getirilirken bir hata oluştu.')}</div>
                        <button class="sf-retry-btn" id="sfRetry">Tekrar Dene</button>
                    </div>`;
                const btn = document.getElementById('sfRetry');
                if (btn) btn.addEventListener('click', loadFlights);
            }
            function showEmpty() {
                listEl.innerHTML = `
                    <div class="sf-state">
                        <i class="bi bi-airplane"></i>
                        <div>Bu arama için uygun uçuş bulunamadı.</div>
                    </div>`;
            }

            /* ---------- 4. Backend'den uçuşları çek ---------- */
            async function loadFlights() {
                if (!fromCity || !toCity || !depart) {
                    showError('Arama bilgileri eksik. Lütfen aramayı yeniden yapın.');
                    return;
                }

                showSkeleton();
                countEl.textContent = '';

                const qs = new URLSearchParams({
                    fromCity, toCity, depart,
                    adults: String(adults),
                    cabin, currency
                });

                try {
                    const res = await fetch('/Flight/SearchFlights?' + qs.toString());
                    if (!res.ok) throw new Error('Sunucu hatası (' + res.status + ')');

                    const data = await res.json();

                    if (!data.success) {
                        showError(data.error || 'Uçuşlar getirilemedi.');
                        return;
                    }

                    // Özet çubuğundaki IATA'ları backend'in çözdüğü kesin değerle güncelle
                    if (data.fromIata) {
                        const iataEls = routeEl.querySelectorAll('.sf-iata');
                        if (iataEls[0]) iataEls[0].textContent = data.fromIata;
                        if (iataEls[1]) iataEls[1].textContent = data.toIata;
                    }

                    const flights = data.flights || [];
                    if (!flights.length) { showEmpty(); return; }

                    listEl.innerHTML = flights.map(cardHtml).join('');
                    countEl.textContent = `${flights.length} uçuş bulundu`;

                } catch (err) {
                    showError(err.message);
                }
            }

            /* ---------- 5. Başlat ---------- */
            loadFlights();

        })();
    </script>
</body>
</html>